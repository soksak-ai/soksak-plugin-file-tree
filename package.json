{
  "name": "soksak-plugin-file-tree",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.22.0",
  "description": "soksak file-tree plugin — left sidebar file explorer tree",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.node.mjs && vitest run",
    "test-unit": "pnpm typecheck && pnpm test",
    "verify": "pnpm typecheck && pnpm test && node build.mjs --check"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
